# AI Configuration (Anthropic Standard API)
# 支持 Anthropic 官方或第三方兼容服务（如硅基流动、OpenRouter 等）
AI_BASE_URL=https://api.anthropic.com
AI_API_KEY=sk-ant-api-your-key-here
AI_MODEL=claude-3-sonnet-20240229

# 第三方服务示例：
# 硅基流动: AI_BASE_URL=https://api.siliconflow.cn/v1, AI_MODEL=claude-3-sonnet
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1, AI_MODEL=anthropic/claude-3-sonnet

# App Settings
APP_NAME=InfoHub
DEBUG=true
DATABASE_URL=sqlite:///./data/infohub.db

# News Sources
NEWSAPI_KEY=your-newsapi-key  # Optional, for NewsAPI
